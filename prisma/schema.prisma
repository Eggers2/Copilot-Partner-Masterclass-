// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
  WAITLIST
  WEBINAR_ATTENDED
  FOLLOW_UP
}

enum LeadSource {
  WEBSITE
  REFERRAL
  LINKEDIN
  WEBINAR
  COLD_OUTREACH
  OTHER
}

enum ActivityType {
  NOTE
  EMAIL
  CALL
  MEETING
  STATUS_CHANGE
  FOLLOW_UP
  WEBINAR
}

enum WebinarStatus {
  PLANNED
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum NewsletterStatus {
  DRAFT
  APPROVED
  SENDING
  SENT
  FAILED
}

enum AdnChannel {
  NONE
  ADN_50
  ADN_15
}

enum KlasseStatus {
  PLANNED
  OPEN
  CLOSED
  RUNNING
  COMPLETED
}

enum TerminStatus {
  GEPLANT
  DURCHGEFUEHRT
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
}

// ─── Stand-Abfrage (monatliche Umfrage-Runden) ───────────────────────────────

enum UmfrageRundeStatus {
  OFFEN
  ABGESCHLOSSEN
}

// Störgröße je Runde für den Kohortenvergleich; bei ≠ NORMAL keine Erinnerung.
enum Jahreszeit {
  NORMAL
  FERIENFENSTER
  JAHRESWECHSEL
}

// Antwort auf die Rollenfrage. WEISS_NICHT ist ein Alarm, keine Antwort.
enum TeilnehmerRolle {
  VERTRIEB
  BERATUNG
  BEIDES
  TECHNIK
  GESCHAEFTSFUEHRUNG
  WEISS_NICHT
}

// Größenklasse der Firma (Mitarbeiter) für den Kohortenvergleich.
enum Groessenklasse {
  UNTER_10
  VON_10_BIS_50
  VON_51_BIS_150
  UEBER_150
}

// Antwortoptionen der rotierenden Programmfrage.
enum RotierendeAntwort {
  JA
  NEIN_GEPLANT
  NEIN
  NICHT_RELEVANT
}

// Über welchen Weg die Antwort kam: persönlicher Mail-Link oder Klassen-QR.
enum UmfrageKanal {
  EMAIL
  KLASSE
}

enum EventRegistrationStatus {
  CONFIRMED
  CANCELLED
}

enum EventWaitlistStatus {
  WAITING
  PROMOTED
  CANCELLED
}

enum EventInvoiceStatus {
  PENDING
  CREATED
  SENT
  FAILED
}

model Klasse {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  kickoffDate       DateTime     @map("kickoff_date")
  startDate         DateTime     @map("start_date")
  endDate           DateTime     @map("end_date")
  capacity          Int?
  status            KlasseStatus @default(PLANNED)
  teilnehmerSperre  Boolean      @default(false) @map("teilnehmer_sperre")
  description       String?
  // GUID der M365-Gruppe (= Teams-Team-ID) dieser Klasse. Steuert im Native-Modus,
  // in welches Teams-Team die Gäste dieser Klasse aufgenommen werden. NULL = kein
  // Team hinterlegt → die Aufnahme wird übersprungen (siehe lib/teams/dispatchTeamsGuest.ts).
  teamsGroupId      String?      @map("teams_group_id")
  // Regel zur automatischen Terminerzeugung (n-ter Wochentag im Monat).
  // Array von Mustern: [{ week: 1-4 | -1 (=letzter), weekday: 1-7 (ISO, 1=Mo),
  // time: "HH:mm" }]. Siehe lib/termine/regel.ts.
  terminRegel       Json?        @map("termin_regel")
  // Curriculum-Stand bei Kickoff, Freitext z.B. "M1-M4" (Störgröße für den
  // Kohortenvergleich der Stand-Abfrage).
  curriculumStand   String?      @map("curriculum_stand")
  webinars          Webinar[]
  bestellungen      Bestellung[]
  leads             Lead[]
  termine           KlasseTermin[]
  umfrageRunden     UmfrageRunde[]
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@map("klassen")
}

// Termine einer Klasse (typ. zwei pro Monat). Hält fest, welches Thema an
// welchem Termin behandelt wurde bzw. geplant ist – getrennt vom Webinar-Modell,
// das öffentliche Online-Events mit Anmeldungen abbildet.
model KlasseTermin {
  id        String       @id @default(cuid())
  klasseId  String       @map("klasse_id")
  klasse    Klasse       @relation(fields: [klasseId], references: [id], onDelete: Cascade)
  datum     DateTime
  thema     String?
  notizen   String?
  status    TerminStatus @default(GEPLANT)
  // Termin liegt im Ferienfenster oder Jahreswechsel: wirkt auf die Erinnerung
  // der Stand-Abfrage und die Deutung von Anwesenheit/ausbleibenden Antworten.
  ferien    Boolean      @default(false)
  // Links für schnellen Zugriff: SharePoint-Aufzeichnung und Teams-Meeting.
  videoUrl            String?   @map("video_url")
  teamsLink           String?   @map("teams_link")
  // Transkript-Upload nach dem Termin + KI-Ausgaben:
  // zusammenfassung = kompakte Spiegelstrichliste (Admin-Überblick),
  // protokoll = ausführliches Meetingprotokoll (Versand an Teilnehmer).
  transkript          String?
  transkriptDateiname String?   @map("transkript_dateiname")
  zusammenfassung     String?
  protokoll           String?
  protokollGesendetAm DateTime? @map("protokoll_gesendet_am")
  // Anwesenheitsbericht (MS-Teams-Export) nach dem Termin: Metadaten hier,
  // die einzelnen Teilnehmer-Zeilen in TerminAnwesenheit.
  anwesenheitDateiname    String?   @map("anwesenheit_dateiname")
  anwesenheitImportiertAm DateTime? @map("anwesenheit_importiert_am")
  anwesenheiten           TerminAnwesenheit[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([klasseId])
  @@map("klasse_termine")
}

// Eine Zeile des Teams-Anwesenheitsberichts (Abschnitt "2. Teilnehmer") je
// Termin. E-Mail ist normalisiert (lowercase); der Abgleich mit den im Shop
// gemeldeten Teilnehmern (BestellungTeilnehmer) passiert zur Lesezeit über
// die E-Mail-Adresse (siehe lib/db/anwesenheit.ts) – so wirken Nachmeldungen
// im Kundenportal rückwirkend auf die Auswertung.
model TerminAnwesenheit {
  id               String       @id @default(cuid())
  terminId         String       @map("termin_id")
  termin           KlasseTermin @relation(fields: [terminId], references: [id], onDelete: Cascade)
  name             String
  email            String       @default("")
  rolle            String?
  dauerSekunden    Int          @default(0) @map("dauer_sekunden")
  ersterBeitritt   DateTime?    @map("erster_beitritt")
  letztesVerlassen DateTime?    @map("letztes_verlassen")
  erstelltAm       DateTime     @default(now()) @map("erstellt_am")

  @@index([terminId])
  @@map("termin_anwesenheiten")
}

model Lead {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                @unique
  name                 String?
  company              String?
  street               String?
  zip                  String?
  city                 String?
  website              String?
  phone                String?
  latitude             Float?
  longitude            Float?
  status               LeadStatus            @default(NEW)
  source               LeadSource            @default(WEBSITE)
  notes                String?
  score                Int                   @default(0)
  revenue              Int                   @default(0)
  followUpAt           DateTime?
  webinarRegistered    Boolean               @default(false) @map("webinar_registered")
  showOnMap            Boolean               @default(true) @map("show_on_map")
  adnChannel           AdnChannel            @default(NONE) @map("adn_channel")
  klasseId             String?               @map("klasse_id")
  klasse               Klasse?               @relation(fields: [klasseId], references: [id])
  utmSource            String?               @map("utm_source") @db.VarChar(100)
  utmMedium            String?               @map("utm_medium") @db.VarChar(100)
  utmCampaign          String?               @map("utm_campaign") @db.VarChar(100)
  utmContent           String?               @map("utm_content") @db.VarChar(100)
  utmTerm              String?               @map("utm_term") @db.VarChar(100)
  referrer             String?               @db.VarChar(500)
  landingPage          String?               @map("landing_page") @db.VarChar(500)
  firstTouchAt         DateTime?             @map("first_touch_at")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  activities           LeadActivity[]
  webinarRegistrations WebinarRegistration[]
  firstCallScore       FirstCallScore?

  @@index([utmSource])
  @@index([utmCampaign])
  @@map("waitlist")
}

model LeadActivity {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId    String       @db.Uuid
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActivityType
  content   String
  oldValue  String?      @map("old_value")
  newValue  String?      @map("new_value")
  createdAt DateTime     @default(now())

  @@map("lead_activities")
}

model Webinar {
  id              String               @id @default(cuid())
  title           String
  scheduledAt     DateTime             @map("scheduled_at")
  streamyardLink  String?              @map("streamyard_link")
  status          WebinarStatus        @default(PLANNED)
  description     String?
  klasseId        String?              @map("klasse_id")
  klasse          Klasse?              @relation(fields: [klasseId], references: [id])
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  registrations   WebinarRegistration[]

  @@map("webinars")
}

model WebinarRegistration {
  id           String             @id @default(cuid())
  webinarId    String             @map("webinar_id")
  webinar      Webinar            @relation(fields: [webinarId], references: [id])
  leadId       String             @db.Uuid @map("lead_id")
  lead         Lead               @relation(fields: [leadId], references: [id])
  status       RegistrationStatus @default(REGISTERED)
  registeredAt DateTime           @default(now()) @map("registered_at")
  attendedAt   DateTime?          @map("attended_at")
  source       String?

  @@unique([webinarId, leadId])
  @@index([leadId])
  @@index([webinarId])
  @@map("webinar_registrations")
}

model Bestellung {
  id                   Int      @id @default(autoincrement())
  bestellNr            String   @unique @map("bestell_nr")
  paket                String
  userAnzahl           Int      @map("user_anzahl")
  zahlungsmodell       String
  preisNetto           Decimal  @db.Decimal(10, 2) @map("preis_netto")
  listPreisNetto       Decimal? @db.Decimal(10, 2) @map("list_preis_netto")
  mwstSatz             Decimal  @db.Decimal(4, 2) @map("mwst_satz")
  mwstBetrag           Decimal  @db.Decimal(10, 2) @map("mwst_betrag")
  reverseCharge        Boolean  @default(false) @map("reverse_charge")
  reverseChargeHinweis String?  @map("reverse_charge_hinweis")
  preisBrutto          Decimal  @db.Decimal(10, 2) @map("preis_brutto")
  firma                String
  strasse              String
  plz                  String
  ort                  String
  land                 String   @default("DE")
  ustId                String?  @map("ust_id")
  vorname              String
  nachname             String
  email                String
  telefon              String?
  position             String?
  website              String?
  anmerkungen          String?
  showOnMap            Boolean  @default(true) @map("show_on_map")
  latitude             Float?
  longitude            Float?
  status               String   @default("neu")
  adnChannel           AdnChannel @default(NONE) @map("adn_channel")
  // Interne Bestellung (ke solutions, Secom IT, NextVideo): wird vom
  // Umfrage-Versand UND jeder Auswertung ausgeschlossen.
  intern               Boolean  @default(false)
  // Größenklasse der Firma (Mitarbeiter), Störgröße für den Kohortenvergleich.
  groessenklasse       Groessenklasse?
  klasseId             String   @map("klasse_id")
  klasse               Klasse   @relation(fields: [klasseId], references: [id])
  // sevDesk-Kontakt-Cache: gesetzt, sobald für diese Bestellung einmal ein
  // Kontakt in sevDesk gefunden/angelegt wurde (siehe lib/sevdesk.ts).
  sevdeskContactId     String?  @map("sevdesk_contact_id")
  erstelltAm           DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm       DateTime @updatedAt @map("aktualisiert_am")
  teilnehmer           BestellungTeilnehmer[]
  eventRegistrations   EventRegistration[]
  eventWaitlist        EventWaitlist[]

  @@map("bestellungen")
}

model BestellungTeilnehmer {
  id           Int        @id @default(autoincrement())
  bestellungId Int        @map("bestellung_id")
  bestellung   Bestellung @relation(fields: [bestellungId], references: [id], onDelete: Cascade)
  position     Int
  vorname      String     @default("")
  nachname     String     @default("")
  email        String     @default("")
  teamsEingeladenAm DateTime? @map("teams_eingeladen_am")
  // Zuletzt in der Stand-Abfrage gemeldete Rolle (wird je Antwort aktualisiert).
  rolle        TeilnehmerRolle?
  erstelltAm   DateTime   @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")
  eventTeilnahmen EventTeilnehmer[]
  umfrageAntworten UmfrageAntwort[]

  @@unique([bestellungId, position])
  @@index([bestellungId])
  @@map("bestellung_teilnehmer")
}

// ─── Stand-Abfrage: Runden, Antworten, anonymes Feedback ─────────────────────

// Eine Stand-Abfrage-Runde je Klasse. Entsteht am ersten Werktag des Monats
// (Cron-Scan, 08:00 Berlin), sofern die Klasse seit der letzten Runde
// mindestens einen durchgeführten Termin hatte (Schutz gegen leere Runden bei
// verschobenen Sessions). "Runde endet" = Status ABGESCHLOSSEN, gesetzt beim
// Anlegen der Folgerunde. Tokens sind nur gültig, solange status = OFFEN.
model UmfrageRunde {
  id          String             @id @default(cuid())
  klasseId    String             @map("klasse_id")
  klasse      Klasse             @relation(fields: [klasseId], references: [id], onDelete: Cascade)
  nummer      Int // 1-basiert je Klasse; Kohortenvergleich läuft über diese Nummer
  status      UmfrageRundeStatus @default(OFFEN)
  // Datum des Runden-Starts (der Werktag, an dem die Runde entstand)
  stichtag    DateTime
  // Kalendertage seit Klasse.startDate am Stichtag (Europe/Berlin)
  programmtag Int
  jahreszeit  Jahreszeit         @default(NORMAL)
  // Inhalt der rotierenden Frage: "Hast du [Inhalt] in den letzten 30 Tagen
  // bei einem echten Kunden angewendet?" Editierbar bis zum Versand.
  rotierenderInhalt String       @map("rotierender_inhalt")
  // Versand-Claims (Muster protokollGesendetAm / Newsletter-Claiming)
  versandAm              DateTime? @map("versand_am")
  erinnerungAm           DateTime? @map("erinnerung_am")
  lieferrisikoGeprueftAm DateTime? @map("lieferrisiko_geprueft_am")
  abgeschlossenAm        DateTime? @map("abgeschlossen_am")
  erstelltAm             DateTime  @default(now()) @map("erstellt_am")
  aktualisiertAm         DateTime  @updatedAt @map("aktualisiert_am")
  antworten      UmfrageAntwort[]
  anonymFeedback UmfrageAnonymFeedback[]

  @@unique([klasseId, nummer])
  @@index([status])
  @@map("umfrage_runden")
}

// Eine Antwort je Platz je Runde (Upsert, letzter Schreibvorgang gewinnt --
// egal ob über den persönlichen Link oder den Klassen-QR-Link).
model UmfrageAntwort {
  id           String               @id @default(cuid())
  rundeId      String               @map("runde_id")
  runde        UmfrageRunde         @relation(fields: [rundeId], references: [id], onDelete: Cascade)
  teilnehmerId Int                  @map("teilnehmer_id")
  teilnehmer   BestellungTeilnehmer @relation(fields: [teilnehmerId], references: [id], onDelete: Cascade)
  // Snapshot zum Antwortzeitpunkt (Muster EventTeilnehmer): Rückschritte
  // werden namentlich gelistet, auch wenn der Platz später umbenannt wird.
  vorname  String
  nachname String
  email    String
  // Rollenfrage (wird zusätzlich auf BestellungTeilnehmer.rolle persistiert)
  rolle TeilnehmerRolle
  // Kernfrage: genau EINES der beiden Felder ist gesetzt (SQL-CHECK):
  // stufe 0-9 (Roadmap-Leiter) ODER techStufe 0-4 (Technik-Leiter bei TECHNIK)
  stufe     Int?
  techStufe Int? @map("tech_stufe")
  // Blocker 1-8, Mehrfachauswahl + bedingte Folgefragen
  blocker      Int[]
  blockerStufe Int?    @map("blocker_stufe") // nur wenn 1 (Zeit) dabei: Stufe 1-9
  blockerSuche String? @map("blocker_suche") // nur wenn 7 (Material) dabei: Freitext
  // Rotierende Programmfrage
  rotierend RotierendeAntwort
  kanal     UmfrageKanal @default(EMAIL)
  // Einmal-Flag: Rückschritt-Benachrichtigung an den Betreiber wurde gesendet
  rueckschrittGemeldetAm DateTime? @map("rueckschritt_gemeldet_am")
  erstelltAm     DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  @@unique([rundeId, teilnehmerId])
  @@index([rundeId])
  @@index([teilnehmerId])
  @@map("umfrage_antworten")
}

// Anonymes Freitext-Feedback: BEWUSST ohne Personen-/Platz-Referenz und ohne
// Zeitstempel (Zeitstempel würden die Korrelation mit umfrage_antworten
// erlauben). UUID statt cuid als PK: cuids sind zeitlich sortierbar und wären
// damit ebenfalls ein Korrelations-Kanal.
model UmfrageAnonymFeedback {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rundeId  String       @map("runde_id")
  runde    UmfrageRunde @relation(fields: [rundeId], references: [id], onDelete: Cascade)
  klasseId String       @map("klasse_id")
  text     String

  @@index([rundeId])
  @@map("umfrage_anonym_feedback")
}

// ─── Events (z.B. Connect Day) ───────────────────────────────────────────────
// Präsenz-Events mit hartem Personenlimit, auf die sich Bestandskunden im
// Kundenportal anmelden. `seatsTaken` ist der atomare Belegungszähler: Plätze
// werden per konditionalem UPDATE reserviert (kein Count-then-Insert, siehe
// lib/events/connectDay.ts) – so ist Überbuchung auch bei parallelen
// Anmeldungen ausgeschlossen.
model Event {
  id                   String      @id @default(cuid())
  slug                 String      @unique
  name                 String
  ort                  String?
  startAt              DateTime    @map("start_at")
  endAt                DateTime    @map("end_at")
  // Ab wann die Anmeldung im Kundenportal möglich ist (NULL = sofort).
  anmeldestart         DateTime?
  anmeldeschluss       DateTime
  // Admin-Schalter: öffnet die Anmeldung VOR dem Anmeldestart (Testmodus).
  manuellFreigeschaltet Boolean    @default(false) @map("manuell_freigeschaltet")
  capacity             Int         @default(100)
  seatsTaken           Int         @default(0) @map("seats_taken")
  maxProBestellung     Int         @default(3) @map("max_pro_bestellung")
  preisNettoProPerson  Decimal     @db.Decimal(10, 2) @map("preis_netto_pro_person")
  status               EventStatus @default(DRAFT)
  // Nur Bestellungen dieser Klassen dürfen sich anmelden (z.B. ["klasse-1","klasse-2"]).
  erlaubteKlassenSlugs String[]    @map("erlaubte_klassen_slugs")
  beschreibung         String?
  erstelltAm           DateTime    @default(now()) @map("erstellt_am")
  aktualisiertAm       DateTime    @updatedAt @map("aktualisiert_am")
  registrations        EventRegistration[]
  waitlist             EventWaitlist[]

  @@map("events")
}

model EventRegistration {
  id             String                  @id @default(cuid())
  eventId        String                  @map("event_id")
  event          Event                   @relation(fields: [eventId], references: [id])
  bestellungId   Int                     @map("bestellung_id")
  bestellung     Bestellung              @relation(fields: [bestellungId], references: [id])
  status         EventRegistrationStatus @default(CONFIRMED)
  personen       Int
  // Preis-Snapshot zum Anmeldezeitpunkt (Preisänderungen am Event wirken
  // nicht rückwirkend auf bereits erstellte Rechnungen).
  preisNetto     Decimal                 @db.Decimal(10, 2) @map("preis_netto")
  mwstSatz       Decimal                 @db.Decimal(4, 2) @map("mwst_satz")
  mwstBetrag     Decimal                 @db.Decimal(10, 2) @map("mwst_betrag")
  preisBrutto    Decimal                 @db.Decimal(10, 2) @map("preis_brutto")
  reverseCharge  Boolean                 @default(false) @map("reverse_charge")
  // sevDesk-Rechnung (automatisch nach der Anmeldung; Retry im Admin)
  invoiceStatus    EventInvoiceStatus @default(PENDING) @map("invoice_status")
  sevdeskContactId String?            @map("sevdesk_contact_id")
  sevdeskInvoiceId String?            @map("sevdesk_invoice_id")
  sevdeskInvoiceNr String?            @map("sevdesk_invoice_nr")
  invoiceError     String?            @map("invoice_error")
  invoiceSentAt    DateTime?          @map("invoice_sent_at")
  // Zahlungseingang – wird manuell im Admin abgehakt; erst dann gilt der
  // Platz als verbindlich bestätigt.
  bezahltAm        DateTime?          @map("bezahlt_am")
  angemeldetVon  String                  @map("angemeldet_von")
  stornoAm       DateTime?               @map("storno_am")
  stornoNotiz    String?                 @map("storno_notiz")
  erstelltAm     DateTime                @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime                @updatedAt @map("aktualisiert_am")
  teilnehmer     EventTeilnehmer[]

  // Eine Bestellung kann MEHRERE bestätigte Anmeldungen haben (Nachmeldung
  // weiterer Personen, jede mit eigener Rechnung). Das Firmen-Kontingent
  // (Event.maxProBestellung) und die Personen-Doppelanmeldung werden
  // transaktional in lib/events/connectDay.ts geprüft. Stornierte
  // Anmeldungen bleiben als Audit-Zeilen stehen.
  @@index([eventId])
  @@index([bestellungId])
  @@map("event_registrations")
}

// Einzelne Plätze einer Event-Anmeldung. Es sind nur Personen wählbar, die
// bereits Masterclass-Teilnehmer der Bestellung sind (FK auf
// BestellungTeilnehmer); Name/E-Mail werden zusätzlich als Snapshot zum
// Anmeldezeitpunkt gespeichert.
model EventTeilnehmer {
  id                     String               @id @default(cuid())
  registrationId         String               @map("registration_id")
  registration           EventRegistration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  position               Int
  bestellungTeilnehmerId Int                  @map("bestellung_teilnehmer_id")
  bestellungTeilnehmer   BestellungTeilnehmer @relation(fields: [bestellungTeilnehmerId], references: [id])
  vorname                String
  nachname               String
  email                  String
  hinweise               String?
  erstelltAm             DateTime             @default(now()) @map("erstellt_am")
  aktualisiertAm         DateTime             @updatedAt @map("aktualisiert_am")

  @@unique([registrationId, position])
  @@unique([registrationId, bestellungTeilnehmerId])
  @@map("event_teilnehmer")
}

// Warteliste zum Connect Day. Wird befüllt, sobald das Event ausgebucht ist
// (kundenportal/connect-day). Partner tragen sich mit Kontakt + gewünschter
// Personenzahl ein; das Nachrücken passiert BEWUSST manuell im Admin (kein
// Auto-Versand, keine automatische Anmeldung) – der Betreiber behält die
// Kontrolle, welcher Eintrag bei einem Storno einen frei gewordenen Platz
// bekommt. `status` protokolliert den Verlauf (WAITING → PROMOTED bzw.
// CANCELLED, wenn der Partner sich selbst wieder austrägt).
model EventWaitlist {
  id             String              @id @default(cuid())
  eventId        String              @map("event_id")
  event          Event               @relation(fields: [eventId], references: [id])
  bestellungId   Int                 @map("bestellung_id")
  bestellung     Bestellung          @relation(fields: [bestellungId], references: [id])
  // Wer den Eintrag angelegt hat (Session-E-Mail) – für die Ownership-Prüfung
  // beim Selbst-Austragen im Kundenportal.
  angemeldetVon  String              @map("angemeldet_von")
  kontaktName    String              @map("kontakt_name")
  kontaktEmail   String              @map("kontakt_email")
  personen       Int                 @default(1)
  notiz          String?
  status         EventWaitlistStatus @default(WAITING)
  promotedAm     DateTime?           @map("promoted_am")
  erstelltAm     DateTime            @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime            @updatedAt @map("aktualisiert_am")

  @@index([eventId, status])
  @@index([bestellungId])
  @@map("event_waitlist")
}

model Newsletter {
  id             String           @id @default(cuid())
  ausgabeNr      Int              @map("ausgabe_nr")
  kw             Int
  jahr           Int
  titel          String           @default("Copilot Insider Update")
  subtitle       String?
  status         NewsletterStatus @default(DRAFT)
  content        Json
  html           String?
  zusatzMails    String?          @map("zusatz_mails")
  recipients     Json?
  freigegebenAm  DateTime?        @map("freigegeben_am")
  gesendetAm     DateTime?        @map("gesendet_am")
  fehlerText     String?          @map("fehler_text")
  erstelltAm     DateTime         @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime         @updatedAt @map("aktualisiert_am")

  @@index([status, gesendetAm])
  @@map("newsletters")
}

// Abmeldungen vom Masterclass-Newsletter (Suppression-Liste). Wird beim Versand
// herausgefiltert. Befüllt über den signierten Abmelde-Link bzw. die
// List-Unsubscribe-One-Click-Funktion der Mail-Clients.
model NewsletterAbmeldung {
  id         String   @id @default(cuid())
  email      String   @unique
  grund      String?
  erstelltAm DateTime @default(now()) @map("erstellt_am")

  @@map("newsletter_abmeldungen")
}

model KundenOtpCode {
  id           Int      @id @default(autoincrement())
  codeHash     String   @map("code_hash")
  email        String
  ablaufAm     DateTime @map("ablauf_am")
  eingeloest   Boolean  @default(false)
  fehlversuche Int      @default(0)
  erstelltAm   DateTime @default(now()) @map("erstellt_am")

  @@index([email, ablaufAm])
  @@map("kunden_otp_codes")
}

// ==========================================
// Kanban Board Models (for /tasks route)
// ==========================================

model TaskUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(100)
  role         String   @default("member") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")
  tasks        Task[]

  @@map("task_users")
}

model TaskColumn {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(100)
  position Int
  color    String? @db.VarChar(7)
  tasks    Task[]

  @@map("task_columns")
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?
  columnId    Int       @map("column_id")
  column      TaskColumn @relation(fields: [columnId], references: [id])
  position    Int
  workstream  String?   @db.VarChar(50)
  responsible String?   @db.VarChar(30)
  priority    String?   @db.VarChar(20)
  deadline    DateTime? @db.Date
  notes       String?
  weekLabel   String?   @map("week_label") @db.VarChar(100)
  createdBy   Int?      @map("created_by")
  creator     TaskUser? @relation(fields: [createdBy], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  tags        TaskTagAssignment[]

  @@map("tasks")
}

model TaskTag {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(50)
  color    String @db.VarChar(7)
  category String? @db.VarChar(30)
  tasks    TaskTagAssignment[]

  @@map("task_tags")
}

model TaskRisk {
  id         Int    @id @default(autoincrement())
  risk       String @db.VarChar(255)
  priority   String @db.VarChar(20) // 'Hoch', 'Mittel', 'Niedrig'
  mitigation String
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("task_risks")
}

model TaskTagAssignment {
  taskId Int @map("task_id")
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  Int  @map("tag_id")
  tag    TaskTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tag_assignments")
}

// ==========================================
// First Call Scoring (Qualifikations-Scorecard)
// ==========================================

model FirstCallScore {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId             String    @unique @db.Uuid @map("lead_id")
  lead               Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Scorecard-Kriterien (je 1–5 Punkte)
  copilotDemand      Int       @default(1) @map("copilot_demand")
  currentOffer       Int       @default(1) @map("current_offer")
  teamCapacity       Int       @default(1) @map("team_capacity")
  decisionMaker      Int       @default(1) @map("decision_maker")
  budgetReadiness    Int       @default(1) @map("budget_readiness")
  urgency            Int       @default(1)
  mindset            Int       @default(1)
  msPartnerStatus    Int       @default(1) @map("ms_partner_status")
  totalScore         Int       @default(8) @map("total_score")

  // Gesprächsnotizen
  description        String?
  painPoint          String?   @map("pain_point")
  teamSize           String?   @map("team_size")
  recommendedPackage String?   @map("recommended_package")
  objections         String?
  nextStep           String?   @map("next_step")
  followUpDate       DateTime? @map("follow_up_date") @db.Date
  contactSource      String?   @map("contact_source")

  // KI-Auswertung (VTT-Transkript via Claude Sonnet)
  transcriptText     String?   @map("transcript_text")
  transcriptFilename String?   @map("transcript_filename")
  scoreReasoning     Json?     @map("score_reasoning")
  analyzedAt         DateTime? @map("analyzed_at")

  // Zeitstempel
  calledAt           DateTime  @default(now()) @map("called_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("first_call_scores")
}

// ─── Email / Resend ──────────────────────────────────────────────────────────
// Editierbare HTML-Templates für transaktionale Mails. Pro Template entscheidet
// `aktiv`, ob der Versand über Resend (true) oder weiter über n8n (false) läuft.
model EmailTemplate {
  id             String   @id @default(cuid())
  key            String   @unique // Maschinen-Key, z.B. "kundenportal_otp"
  name           String // Anzeigename im Portal
  betreff        String // Subject, unterstützt {{platzhalter}}
  html           String // Body-HTML, unterstützt {{platzhalter}}
  beschreibung   String? // Hinweis auf verfügbare Variablen
  aktiv          Boolean  @default(false) // true → Resend, false → n8n-Fallback
  erstelltAm     DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  @@map("email_templates")
}

// Protokoll jedes Versandversuchs (Resend wie n8n) – heute fehlt jegliches Log.
model EmailLog {
  id          String   @id @default(cuid())
  templateKey String?  @map("template_key")
  empfaenger  String
  betreff     String
  provider    String // "resend" | "n8n"
  status      String // "sent" | "failed"
  providerId  String?  @map("provider_id") // Resend Message-ID
  fehlerText  String?  @map("fehler_text")
  erstelltAm  DateTime @default(now()) @map("erstellt_am")

  @@index([erstelltAm])
  @@map("email_logs")
}

// ─── App-weite Einstellungen (generischer Key/Value-Store) ──────────────────
// Laufzeit-Schalter, die im Admin umgelegt werden können – analog zum
// EmailTemplate.aktiv-Flag, aber nicht an ein einzelnes Template gebunden.
// Aktueller Key: "teams_aufnahme_modus" = "nativ" | "n8n" (Default ohne Row: "n8n").
model AppSetting {
  key            String   @id
  value          String
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  @@map("app_settings")
}
