// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
  WAITLIST
  WEBINAR_ATTENDED
  FOLLOW_UP
}

enum LeadSource {
  WEBSITE
  REFERRAL
  LINKEDIN
  WEBINAR
  COLD_OUTREACH
  OTHER
}

enum ActivityType {
  NOTE
  EMAIL
  CALL
  MEETING
  STATUS_CHANGE
  FOLLOW_UP
  WEBINAR
}

enum WebinarStatus {
  PLANNED
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum NewsletterStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

model Lead {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                @unique
  name                 String?
  company              String?
  street               String?
  zip                  String?
  city                 String?
  website              String?
  phone                String?
  latitude             Float?
  longitude            Float?
  status               LeadStatus            @default(NEW)
  source               LeadSource            @default(WEBSITE)
  notes                String?
  score                Int                   @default(0)
  revenue              Int                   @default(0)
  followUpAt           DateTime?
  webinarRegistered    Boolean               @default(false) @map("webinar_registered")
  showOnMap            Boolean               @default(true) @map("show_on_map")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  activities           LeadActivity[]
  webinarRegistrations WebinarRegistration[]
  firstCallScore       FirstCallScore?

  @@map("waitlist")
}

model LeadActivity {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId    String       @db.Uuid
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActivityType
  content   String
  oldValue  String?      @map("old_value")
  newValue  String?      @map("new_value")
  createdAt DateTime     @default(now())

  @@map("lead_activities")
}

model Webinar {
  id              String               @id @default(cuid())
  title           String
  scheduledAt     DateTime             @map("scheduled_at")
  streamyardLink  String?              @map("streamyard_link")
  status          WebinarStatus        @default(PLANNED)
  description     String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  registrations   WebinarRegistration[]

  @@map("webinars")
}

model WebinarRegistration {
  id           String             @id @default(cuid())
  webinarId    String             @map("webinar_id")
  webinar      Webinar            @relation(fields: [webinarId], references: [id])
  leadId       String             @db.Uuid @map("lead_id")
  lead         Lead               @relation(fields: [leadId], references: [id])
  status       RegistrationStatus @default(REGISTERED)
  registeredAt DateTime           @default(now()) @map("registered_at")
  attendedAt   DateTime?          @map("attended_at")
  source       String?

  @@unique([webinarId, leadId])
  @@index([leadId])
  @@index([webinarId])
  @@map("webinar_registrations")
}

model Bestellung {
  id                   Int      @id @default(autoincrement())
  bestellNr            String   @unique @map("bestell_nr")
  paket                String
  userAnzahl           Int      @map("user_anzahl")
  zahlungsmodell       String
  preisNetto           Decimal  @db.Decimal(10, 2) @map("preis_netto")
  mwstSatz             Decimal  @db.Decimal(4, 2) @map("mwst_satz")
  mwstBetrag           Decimal  @db.Decimal(10, 2) @map("mwst_betrag")
  reverseCharge        Boolean  @default(false) @map("reverse_charge")
  reverseChargeHinweis String?  @map("reverse_charge_hinweis")
  preisBrutto          Decimal  @db.Decimal(10, 2) @map("preis_brutto")
  firma                String
  strasse              String
  plz                  String
  ort                  String
  land                 String   @default("DE")
  ustId                String?  @map("ust_id")
  vorname              String
  nachname             String
  email                String
  telefon              String?
  position             String?
  anmerkungen          String?
  showOnMap            Boolean  @default(true) @map("show_on_map")
  status               String   @default("neu")
  erstelltAm           DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm       DateTime @updatedAt @map("aktualisiert_am")
  teilnehmer           BestellungTeilnehmer[]

  @@map("bestellungen")
}

model BestellungTeilnehmer {
  id           Int        @id @default(autoincrement())
  bestellungId Int        @map("bestellung_id")
  bestellung   Bestellung @relation(fields: [bestellungId], references: [id], onDelete: Cascade)
  position     Int
  vorname      String     @default("")
  nachname     String     @default("")
  email        String     @default("")
  teamsEingeladenAm DateTime? @map("teams_eingeladen_am")
  erstelltAm   DateTime   @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  @@unique([bestellungId, position])
  @@index([bestellungId])
  @@map("bestellung_teilnehmer")
}

model Newsletter {
  id             String           @id @default(cuid())
  ausgabeNr      Int              @map("ausgabe_nr")
  kw             Int
  jahr           Int
  titel          String           @default("Copilot Insider Update")
  subtitle       String?
  status         NewsletterStatus @default(DRAFT)
  content        Json
  html           String?
  zusatzMails    String?          @map("zusatz_mails")
  recipients     Json?
  gesendetAm     DateTime?        @map("gesendet_am")
  fehlerText     String?          @map("fehler_text")
  erstelltAm     DateTime         @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime         @updatedAt @map("aktualisiert_am")

  @@index([status, gesendetAm])
  @@map("newsletters")
}

model KundenMagicLink {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique @map("token_hash")
  email      String
  ablaufAm   DateTime @map("ablauf_am")
  eingeloest Boolean  @default(false)
  erstelltAm DateTime @default(now()) @map("erstellt_am")

  @@index([email])
  @@index([ablaufAm])
  @@map("kunden_magic_links")
}

// ==========================================
// Kanban Board Models (for /tasks route)
// ==========================================

model TaskUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(100)
  role         String   @default("member") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")
  tasks        Task[]

  @@map("task_users")
}

model TaskColumn {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(100)
  position Int
  color    String? @db.VarChar(7)
  tasks    Task[]

  @@map("task_columns")
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?
  columnId    Int       @map("column_id")
  column      TaskColumn @relation(fields: [columnId], references: [id])
  position    Int
  workstream  String?   @db.VarChar(50)
  responsible String?   @db.VarChar(30)
  priority    String?   @db.VarChar(20)
  deadline    DateTime? @db.Date
  notes       String?
  weekLabel   String?   @map("week_label") @db.VarChar(100)
  createdBy   Int?      @map("created_by")
  creator     TaskUser? @relation(fields: [createdBy], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  tags        TaskTagAssignment[]

  @@map("tasks")
}

model TaskTag {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(50)
  color    String @db.VarChar(7)
  category String? @db.VarChar(30)
  tasks    TaskTagAssignment[]

  @@map("task_tags")
}

model TaskRisk {
  id         Int    @id @default(autoincrement())
  risk       String @db.VarChar(255)
  priority   String @db.VarChar(20) // 'Hoch', 'Mittel', 'Niedrig'
  mitigation String
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("task_risks")
}

model TaskTagAssignment {
  taskId Int @map("task_id")
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  Int  @map("tag_id")
  tag    TaskTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tag_assignments")
}

// ==========================================
// First Call Scoring (Qualifikations-Scorecard)
// ==========================================

model FirstCallScore {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId             String    @unique @db.Uuid @map("lead_id")
  lead               Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Scorecard-Kriterien (je 1–5 Punkte)
  copilotDemand      Int       @default(1) @map("copilot_demand")
  currentOffer       Int       @default(1) @map("current_offer")
  teamCapacity       Int       @default(1) @map("team_capacity")
  decisionMaker      Int       @default(1) @map("decision_maker")
  budgetReadiness    Int       @default(1) @map("budget_readiness")
  urgency            Int       @default(1)
  mindset            Int       @default(1)
  msPartnerStatus    Int       @default(1) @map("ms_partner_status")
  totalScore         Int       @default(8) @map("total_score")

  // Gesprächsnotizen
  description        String?
  painPoint          String?   @map("pain_point")
  teamSize           String?   @map("team_size")
  recommendedPackage String?   @map("recommended_package")
  objections         String?
  nextStep           String?   @map("next_step")
  followUpDate       DateTime? @map("follow_up_date") @db.Date
  contactSource      String?   @map("contact_source")

  // Zeitstempel
  calledAt           DateTime  @default(now()) @map("called_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("first_call_scores")
}
