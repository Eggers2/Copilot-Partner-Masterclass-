// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
  WAITLIST
  SEQUENCE_ACTIVE
  WEBINAR_INVITED
  WEBINAR_ATTENDED
  FOLLOW_UP
}

enum LeadSource {
  WEBSITE
  REFERRAL
  LINKEDIN
  WEBINAR
  COLD_OUTREACH
  OTHER
}

enum ActivityType {
  NOTE
  EMAIL
  CALL
  MEETING
  STATUS_CHANGE
  FOLLOW_UP
  WEBINAR
}

enum WebinarStatus {
  PLANNED
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  NO_SHOW
  CANCELLED
}

model Lead {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                @unique
  name                 String?
  company              String?
  phone                String?
  status               LeadStatus            @default(NEW)
  source               LeadSource            @default(WEBSITE)
  notes                String?
  score                Int                   @default(0)
  followUpAt           DateTime?
  webinarRegistered    Boolean               @default(false) @map("webinar_registered")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  activities           LeadActivity[]
  webinarRegistrations WebinarRegistration[]

  @@map("waitlist")
}

model LeadActivity {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId    String       @db.Uuid
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActivityType
  content   String
  oldValue  String?      @map("old_value")
  newValue  String?      @map("new_value")
  createdAt DateTime     @default(now())

  @@map("lead_activities")
}

model Webinar {
  id            String               @id @default(cuid())
  title         String
  slug          String               @unique
  scheduledAt   DateTime             @map("scheduled_at")
  durationMin   Int                  @default(60) @map("duration_min")
  zoomLink      String?              @map("zoom_link")
  maxAttendees  Int                  @default(50) @map("max_attendees")
  status        WebinarStatus        @default(PLANNED)
  description   String?
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  registrations WebinarRegistration[]

  @@map("webinars")
}

model WebinarRegistration {
  id           String             @id @default(cuid())
  webinarId    String             @map("webinar_id")
  webinar      Webinar            @relation(fields: [webinarId], references: [id])
  leadId       String             @db.Uuid @map("lead_id")
  lead         Lead               @relation(fields: [leadId], references: [id])
  status       RegistrationStatus @default(REGISTERED)
  registeredAt DateTime           @default(now()) @map("registered_at")
  attendedAt   DateTime?          @map("attended_at")
  source       String?

  @@unique([webinarId, leadId])
  @@index([leadId])
  @@index([webinarId])
  @@map("webinar_registrations")
}

model Bestellung {
  id                   Int      @id @default(autoincrement())
  bestellNr            String   @unique @map("bestell_nr")
  paket                String
  userAnzahl           Int      @map("user_anzahl")
  zahlungsmodell       String
  preisNetto           Decimal  @db.Decimal(10, 2) @map("preis_netto")
  mwstSatz             Decimal  @db.Decimal(4, 2) @map("mwst_satz")
  mwstBetrag           Decimal  @db.Decimal(10, 2) @map("mwst_betrag")
  reverseCharge        Boolean  @default(false) @map("reverse_charge")
  reverseChargeHinweis String?  @map("reverse_charge_hinweis")
  preisBrutto          Decimal  @db.Decimal(10, 2) @map("preis_brutto")
  firma                String
  strasse              String
  plz                  String
  ort                  String
  land                 String   @default("DE")
  ustId                String?  @map("ust_id")
  vorname              String
  nachname             String
  email                String
  telefon              String?
  position             String?
  anmerkungen          String?
  status               String   @default("neu")
  erstelltAm           DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm       DateTime @updatedAt @map("aktualisiert_am")

  @@map("bestellungen")
}
