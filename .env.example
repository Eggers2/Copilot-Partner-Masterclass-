# ─────────────────────────────────────────────────────────
# Copilot Partner Masterclass – Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env.local for local development
# On Railway, set these as environment variables in the dashboard

# ─── PostgreSQL Database ──────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Railway provides this automatically when you add a PostgreSQL plugin
DATABASE_URL="postgresql://postgres:password@localhost:5432/copilot_masterclass"

# ─── Admin Dashboard ─────────────────────────────────────
# Set a strong, unique password to protect the /admin route
ADMIN_PASSWORD="change-me-to-a-strong-password"

# ─── N8N Webhook Integration ─────────────────────────────
# Wird nach jeder Waitlist-Anmeldung aufgerufen (fire-and-forget).
# URL aus dem N8N Webhook-Trigger-Node kopieren.
# Ohne diese Variable läuft die App normal (kein Fehler).
N8N_WEBHOOK_URL="https://your-n8n-instance.app.n8n.cloud/webhook/your-unique-id"

# ─── n8n Webhook Secret ─────────────────────────────────
# Authentifizierung für eingehende n8n-Webhooks (x-webhook-secret Header)
N8N_WEBHOOK_SECRET="dein-sicherer-geheimer-schluessel-hier"

# ─── n8n Webinar Webhooks ───────────────────────────────
# Wird nach Webinar-Anmeldung aufgerufen (Bestätigungs-E-Mail)
N8N_WEBHOOK_URL_WEBINAR_CONFIRM="https://your-n8n.cloud/webhook/webinar-confirm"

# Optional: Post-Webinar E-Mail-Sequenz
N8N_WEBHOOK_URL_POST_WEBINAR="https://your-n8n.cloud/webhook/post-webinar"

# ─── n8n Bestellung Webhook ────────────────────────────────
# Wird nach jeder Bestellung aufgerufen (fire-and-forget)
N8N_WEBHOOK_URL_bestellen="https://your-n8n.cloud/webhook/bestellen"

# ─── n8n Kundenportal-OTP ──────────────────────────────────
# Versendet 6-stelligen Login-Code per Outlook-E-Mail. Workflow:
# n8n/kundenportal-otp.json. Payload: { typ:"kundenportal_otp", email, code }.
# Ohne diese Variable schlägt der Login fehl und der Partner sieht eine
# Zustellfehler-Meldung statt eine wartende „Code unterwegs"-Seite.
N8N_WEBHOOK_URL_otp_code="https://your-n8n.cloud/webhook/kundenportal-otp"

# ─── Resend (E-Mail-Versand) ───────────────────────────────
# Schrittweise Ablösung der n8n-/Outlook-Mails durch Resend. Pro Template wird
# im Portal (/admin/emails) entschieden, ob über Resend (aktiv) oder weiter
# über n8n (Fallback) versendet wird. Die N8N_WEBHOOK_URL_* bleiben als
# Fallback bestehen.
# API-Key aus dem Resend-Dashboard (https://resend.com/api-keys).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Absender – Domain muss bei Resend verifiziert sein. Format: "Name <adresse>".
RESEND_FROM_EMAIL="Next Skills <noreply@copilotberater.de>"

# ─── First-Call Entscheidungs-Mail ─────────────────────────
# Antwort-Adresse für die nach dem Erstgespräch versendete Entscheidungs-Mail.
# Da die Mail "antworte einfach kurz auf diese Mail" enthält, sollte hier ein
# echtes Postfach stehen (NICHT noreply@…), z.B. das von Alexander. Ohne Wert
# gehen Antworten an RESEND_FROM_EMAIL.
FIRST_CALL_REPLY_TO="alexander@copilotberater.de"
# Der One Pager wird als PDF aus public/dokumente/onepager.pdf angehängt –
# diese Datei muss im Repo liegen (sonst wird die Mail ohne Anhang versendet).

# ─── Kundenportal-Session-Secret ───────────────────────────
# HMAC-Schlüssel für signierte httpOnly-Cookies (Session und OTP-Pending).
# Min. 16 Zeichen. Beim Wechsel werden alle bestehenden Sessions invalidiert.
CUSTOMER_SESSION_SECRET="bitte-mind-16-zeichen-zufaellig-ersetzen"

# ─── Teams-Gast-Aufnahme (nativ, Microsoft Graph) ──────────
# Native Aufnahme PRO KLASSE: Die App ruft Microsoft Graph direkt auf
# (Gast-Einladung + Aufnahme in die M365-Gruppe/das Team der jeweiligen Klasse).
# Umschaltbar im Admin unter /admin/klassen (Schalter „Teams-Aufnahme").
# Default ist n8n (siehe unten) – ohne diese drei Werte ist „Nativ" nicht aktivierbar.
# Es ist dieselbe Azure-App wie in der n8n-Credential (Client-Credentials-Flow):
#   Application Permissions: User.Invite.All + GroupMember.ReadWrite.All (+ Admin-Consent)
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""

# ─── n8n Teams-Gast-Einladung (Fallback / Default) ─────────
# Bisheriger Weg, bleibt als Fallback erhalten. Aktiv, solange der Schalter im
# Admin auf „n8n" steht (Default). Der n8n-Workflow (n8n/teams-guest-invite.json)
# ruft die Microsoft-Graph-API auf: 1) Gast-Einladung (/invitations)
# 2) Aufnahme in die M365-Gruppe (/groups/{id}/members/$ref) 3) Callback an
# /api/webhooks/n8n zum Markieren von teams_eingeladen_am.
# Ohne diese Variable läuft die App normal (kein Fehler).
N8N_WEBHOOK_URL_teams_guest="https://your-n8n.cloud/webhook/teams-guest-invite"

# ─── Anthropic / Claude API (Newsletter-Redaktion) ───────
# Wird vom Admin-Modul "Newsletter" genutzt, um über die Claude API den
# redaktionellen Text zu den News-Links (aus der Linksammlung, s.u.) zu erzeugen.
# Ohne Key wirft das Admin-Modul einen sprechenden Fehler.
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Linksammlung-API (externe News-Quelle) ──────────────
# Read-only HTTP-API der separaten "Linksammlung"-Railway-Instanz. Liefert die
# kuratierten, KI-aufbereiteten Links (titleDe, summary, longSummary, category,
# siteName …), aus denen das Newsletter-Modul die 5 News-Artikel baut.
# Das Token ist der Wert von API_READ_TOKEN der Linksammlung und gehört rein
# server-seitig. Ohne Token wirft der News-Schritt einen sprechenden Fehler
# (die übrigen Newsletter-Bausteine funktionieren weiter).
# LINKSAMMLUNG_API_URL ist optional (Default = Production-URL unten).
LINKSAMMLUNG_API_URL="https://linksammlung-production.up.railway.app"
LINKSAMMLUNG_API_TOKEN="dein-read-token-der-linksammlung"

# ─── n8n Newsletter-Versand ──────────────────────────────
# Wird vom Admin-Modul "Newsletter" aufgerufen, wenn du einen Newsletter
# versendest oder eine Test-Mail auslöst. Der zugehörige Workflow liegt
# unter n8n/newsletter-send.json und legt einen Outlook-Draft mit allen
# Empfängern in BCC an (manuelle Freigabe durch den Admin).
N8N_WEBHOOK_URL_newsletter="https://your-n8n.cloud/webhook/newsletter-send"

# Absender-Adresse für den Outlook-Draft (steht im To-Feld, BCC sind die
# eigentlichen Empfänger). Fallback in n8n: info@copilotberater.de
# Wird beim Resend-Versand als Reply-To genutzt (Absender = RESEND_FROM_EMAIL).
NEWSLETTER_SENDER_EMAIL="newsletter@copilotberater.de"

# ─── Newsletter-Automatik (GitHub Actions Cron) ──────────
# Der Newsletter läuft automatisch: Do 18:00 Entwurf + Freigabe-Mail,
# Fr 09:00 Versand der freigegebenen Ausgabe (sonst Erinnerung). Versand
# läuft über Resend (s.o.), Scheduling über den GitHub-Actions-Workflow
# .github/workflows/newsletter-cron.yml, der den geschützten Endpoint
# /api/cron/newsletter aufruft.
#
# Gemeinsames Geheimnis zwischen GitHub Actions und Web-App (Header
# x-cron-secret). Lange Zufallszeichenkette, z.B. `openssl rand -hex 32`.
# Muss BEIDES sein: hier (Railway-Web-Service) UND als GitHub-Actions-Secret
# (Repo → Settings → Secrets and variables → Actions → CRON_SECRET).
CRON_SECRET="bitte-lange-zufalls-zeichenkette-ersetzen"

# Empfänger der Freigabe-Benachrichtigung (Do) und der Erinnerung (Fr).
# Ohne Wert wird NEWSLETTER_SENDER_EMAIL verwendet.
NEWSLETTER_REVIEW_EMAIL="ae@nextvideo.de"

# ─── sevDesk (Connect-Day-Rechnungen) ────────────────────
# Automatische Rechnungsstellung bei der Connect-Day-Anmeldung im
# Kundenportal: Kontakt anlegen/finden, Rechnung erstellen (Status "offen",
# Nummer aus dem sevDesk-Nummernkreis) und als PDF per E-Mail versenden.
#
# SEVDESK_API_KEY: API-Token aus sevDesk (Einstellungen → Benutzer → API).
# SEVDESK_MODE: "live" | "mock" | "off".
#   - mock: keine API-Calls, Payloads werden nur geloggt (lokale Tests)
#   - off:  Rechnungen bleiben auf FAILED stehen und können nach der
#           Konfiguration im Admin (/admin/connect-day) erneut angestoßen werden
#   Ohne Wert: live wenn API-Key gesetzt, sonst off.
SEVDESK_API_KEY="dein-sevdesk-api-token"
# SEVDESK_MODE="live"
# SEVDESK_API_URL="https://my.sevdesk.de/api/v1"
# Optional: SevUser-ID als Rechnungs-Kontaktperson (sonst erster Benutzer)
# SEVDESK_SEV_USER_ID="123456"
# Optional: Kontakt-Kategorie für neu angelegte Kontakte (Default 3 = Kunde)
# SEVDESK_CONTACT_CATEGORY_ID="3"

# Empfänger der internen Benachrichtigung, wenn ein Partner seine
# Connect-Day-Anmeldung storniert (Rechnungs-/Stornoabwicklung läuft
# manuell in sevDesk). Ohne Wert wird NEWSLETTER_REVIEW_EMAIL verwendet.
# CONNECT_DAY_NOTIFY_EMAIL="ae@nextvideo.de"

# ─── SYNAXON-Landingpage (/synaxon) ────────────────────────
# Empfänger der Benachrichtigung bei einer Unterlagen-Anfrage über /synaxon.
# Versand über Resend, ohne Resend-Key geht der Warteliste-Webhook
# (N8N_WEBHOOK_URL) mit erweiterter Payload raus. Ohne Wert: info@next-skills.de
# SYNAXON_NOTIFY_EMAIL="info@next-skills.de"

# ─── App Base URL ────────────────────────────────────────
# Öffentliche Basis-URL der Anwendung. Ohne diesen Wert versucht die App, die
# URL aus Request-Headern abzuleiten – hinter manchen Proxies endet das auf
# "localhost:8080" o.ä. In Production daher unbedingt setzen.
APP_BASE_URL="https://www.copilotberater.de"

# ─── Next.js (optional) ──────────────────────────────────
# NODE_ENV is set automatically by Railway
# NODE_ENV="production"
