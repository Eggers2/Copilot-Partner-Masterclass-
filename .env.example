# ─────────────────────────────────────────────────────────
# Copilot Partner Masterclass – Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env.local for local development
# On Railway, set these as environment variables in the dashboard

# ─── PostgreSQL Database ──────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Railway provides this automatically when you add a PostgreSQL plugin
DATABASE_URL="postgresql://postgres:password@localhost:5432/copilot_masterclass"

# ─── Admin Dashboard ─────────────────────────────────────
# Set a strong, unique password to protect the /admin route
ADMIN_PASSWORD="change-me-to-a-strong-password"

# ─── N8N Webhook Integration ─────────────────────────────
# Wird nach jeder Waitlist-Anmeldung aufgerufen (fire-and-forget).
# URL aus dem N8N Webhook-Trigger-Node kopieren.
# Ohne diese Variable läuft die App normal (kein Fehler).
N8N_WEBHOOK_URL="https://your-n8n-instance.app.n8n.cloud/webhook/your-unique-id"

# ─── n8n Webhook Secret ─────────────────────────────────
# Authentifizierung für eingehende n8n-Webhooks (x-webhook-secret Header)
N8N_WEBHOOK_SECRET="dein-sicherer-geheimer-schluessel-hier"

# ─── n8n Webinar Webhooks ───────────────────────────────
# Wird nach Webinar-Anmeldung aufgerufen (Bestätigungs-E-Mail)
N8N_WEBHOOK_URL_WEBINAR_CONFIRM="https://your-n8n.cloud/webhook/webinar-confirm"

# Optional: Post-Webinar E-Mail-Sequenz
N8N_WEBHOOK_URL_POST_WEBINAR="https://your-n8n.cloud/webhook/post-webinar"

# ─── n8n Bestellung Webhook ────────────────────────────────
# Wird nach jeder Bestellung aufgerufen (fire-and-forget)
N8N_WEBHOOK_URL_bestellen="https://your-n8n.cloud/webhook/bestellen"

# ─── n8n Kundenportal-OTP ──────────────────────────────────
# Versendet 6-stelligen Login-Code per Outlook-E-Mail. Workflow:
# n8n/kundenportal-otp.json. Payload: { typ:"kundenportal_otp", email, code }.
# Ohne diese Variable schlägt der Login fehl und der Partner sieht eine
# Zustellfehler-Meldung statt eine wartende „Code unterwegs"-Seite.
N8N_WEBHOOK_URL_otp_code="https://your-n8n.cloud/webhook/kundenportal-otp"

# ─── Resend (E-Mail-Versand) ───────────────────────────────
# Schrittweise Ablösung der n8n-/Outlook-Mails durch Resend. Pro Template wird
# im Portal (/admin/emails) entschieden, ob über Resend (aktiv) oder weiter
# über n8n (Fallback) versendet wird. Die N8N_WEBHOOK_URL_* bleiben als
# Fallback bestehen.
# API-Key aus dem Resend-Dashboard (https://resend.com/api-keys).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Absender – Domain muss bei Resend verifiziert sein. Format: "Name <adresse>".
RESEND_FROM_EMAIL="Next Skills <noreply@copilotberater.de>"

# ─── Kundenportal-Session-Secret ───────────────────────────
# HMAC-Schlüssel für signierte httpOnly-Cookies (Session und OTP-Pending).
# Min. 16 Zeichen. Beim Wechsel werden alle bestehenden Sessions invalidiert.
CUSTOMER_SESSION_SECRET="bitte-mind-16-zeichen-zufaellig-ersetzen"

# ─── n8n Teams-Gast-Einladung ──────────────────────────────
# Wird pro BestellungTeilnehmer mit ausgefüllter E-Mail aufgerufen.
# Der n8n-Workflow (n8n/teams-guest-invite.json) ruft die Microsoft-Graph-API
# auf: 1) Gast-Einladung (/invitations) 2) Hinzufügen zum Ziel-Team
# (/teams/{id}/members) 3) Callback an /api/webhooks/n8n zum Markieren.
# Ohne diese Variable läuft die App normal (kein Fehler).
N8N_WEBHOOK_URL_teams_guest="https://your-n8n.cloud/webhook/teams-guest-invite"

# ─── Anthropic / Claude API (Newsletter-Redaktion) ───────
# Wird vom Admin-Modul "Newsletter" genutzt, um über die Claude API (inkl.
# web_search Tool) aktuelle News, Prompt der Woche und Zahl der Woche zu
# recherchieren. Ohne Key wirft das Admin-Modul einen sprechenden Fehler.
ANTHROPIC_API_KEY="sk-ant-..."

# ─── n8n Newsletter-Versand ──────────────────────────────
# Wird vom Admin-Modul "Newsletter" aufgerufen, wenn du einen Newsletter
# versendest oder eine Test-Mail auslöst. Der zugehörige Workflow liegt
# unter n8n/newsletter-send.json und legt einen Outlook-Draft mit allen
# Empfängern in BCC an (manuelle Freigabe durch den Admin).
N8N_WEBHOOK_URL_newsletter="https://your-n8n.cloud/webhook/newsletter-send"

# Absender-Adresse für den Outlook-Draft (steht im To-Feld, BCC sind die
# eigentlichen Empfänger). Fallback in n8n: info@copilotberater.de
NEWSLETTER_SENDER_EMAIL="newsletter@copilotberater.de"

# ─── App Base URL ────────────────────────────────────────
# Öffentliche Basis-URL der Anwendung. Ohne diesen Wert versucht die App, die
# URL aus Request-Headern abzuleiten – hinter manchen Proxies endet das auf
# "localhost:8080" o.ä. In Production daher unbedingt setzen.
APP_BASE_URL="https://www.copilotberater.de"

# ─── Next.js (optional) ──────────────────────────────────
# NODE_ENV is set automatically by Railway
# NODE_ENV="production"
