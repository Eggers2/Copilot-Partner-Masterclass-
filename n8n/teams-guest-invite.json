    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/invitations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"invitedUserEmailAddress\": \"{{ $json.email }}\",\n  \"invitedUserDisplayName\": \"{{ $json.display_name }}\",\n  \"inviteRedirectUrl\": \"{{ $json.invite_redirect_url }}\",\n  \"sendInvitationMessage\": true\n}",
        "options": {}
      },
      "id": "c0f2c8a1-0004-4c01-9f1a-444444444444",
      "name": "Graph: Gast-Einladung",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 240],
      "credentials": {
        "microsoftOAuth2Api": {
          "id": "REPLACE_WITH_GRAPH_OAUTH_CREDENTIAL_ID",
          "name": "Microsoft Graph (Azure App)"
        }
      },
      "notes": "Azure-App benötigt Application Permission 'User.Invite.All' + Admin-Consent. OAuth-Credential: Grant Type 'Client Credentials', Scope 'https://graph.microsoft.com/.default'. Die API ist idempotent – für bereits eingeladene Gäste wird der bestehende User zurückgegeben."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c-user-id",
              "name": "invited_user_id",
              "value": "={{ $json.invitedUser.id }}",
              "type": "string"
            },
            {
              "id": "c-email",
              "name": "email",
              "value": "={{ $('Felder extrahieren').item.json.email }}",
              "type": "string"
            },
            {
              "id": "c-teilnehmer-id",
              "name": "teilnehmer_id",
              "value": "={{ $('Felder extrahieren').item.json.teilnehmer_id }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "c0f2c8a1-0005-4c01-9f1a-555555555555",
      "name": "User-ID merken",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1160, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.microsoft.com/v1.0/teams/REPLACE_WITH_TEAM_ID/members",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"@odata.type\": \"#microsoft.graph.aadUserConversationMember\",\n  \"roles\": [\"guest\"],\n  \"user@odata.bind\": \"https://graph.microsoft.com/v1.0/users('{{ $json.invited_user_id }}')\"\n}",
        "options": {}
      },
      "id": "c0f2c8a1-0006-4c01-9f1a-666666666666",
      "name": "Graph: Team-Mitglied hinzufügen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 240],
      "credentials": {
        "microsoftOAuth2Api": {
          "id": "REPLACE_WITH_GRAPH_OAUTH_CREDENTIAL_ID",
          "name": "Microsoft Graph (Azure App)"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Azure-App benötigt zusätzlich 'TeamMember.ReadWrite.All'. REPLACE_WITH_TEAM_ID durch die GUID des Ziel-Teams ersetzen. 'Continue On Fail' ist aktiviert, damit 409 (bereits Mitglied) den Callback nicht blockiert."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=REPLACE_WITH_APP_BASE_URL/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "REPLACE_WITH_N8N_WEBHOOK_SECRET"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event\": \"teams_guest_invited\",\n  \"email\": \"{{ $('User-ID merken').item.json.email }}\",\n  \"data\": { \"teilnehmerId\": {{ $('User-ID merken').item.json.teilnehmer_id }} }\n}",
        "options": {}
      },
      "id": "c0f2c8a1-0007-4c01-9f1a-777777777777",
      "name": "Callback an App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 240],
      "notes": "Meldet der App, dass die Einladung erfolgreich war. Die App setzt daraufhin teams_eingeladen_am, damit kein Duplikat-Call entsteht."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"ok\": true,\n  \"message\": \"Teams-Gast eingeladen\"\n}",
        "options": {
          "responseCode": 200
        }
      },
