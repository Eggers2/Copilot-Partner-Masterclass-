                "operation": "equals",
                "name": "filter.operator.equals"
              }
            },
            {
              "id": "cond-email",
              "leftValue": "={{ $json.body.email }}",
              "rightValue": "@",
              "operator": {
                "type": "string",
                "operation": "contains",
                "name": "filter.operator.contains"
              }
            },
            {
              "id": "cond-link",
              "leftValue": "={{ $json.body.link_url }}",
              "rightValue": "https",
              "operator": {
                "type": "string",
                "operation": "startsWith",
                "name": "filter.operator.startsWith"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b0f1b8a1-0002-4c01-9f1a-bbbbbbbbbbbb",
