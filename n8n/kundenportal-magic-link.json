            {
              "id": "a-html",
              "name": "html_body",
              "value": "=<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 560px; margin: 0 auto; padding: 24px; color: #0F172A;\">\n  <div style=\"padding: 16px 0; border-bottom: 1px solid #E2E8F0;\">\n    <h1 style=\"margin: 0; font-size: 20px; color: #030386;\">Dein Login zum Kundenportal</h1>\n  </div>\n  <div style=\"padding: 24px 0; line-height: 1.6; font-size: 15px;\">\n    <p>Hallo,</p>\n    <p>du hast einen Login-Link für das <strong>Next Skills Kundenportal</strong> angefordert. Mit diesem Link kannst du deine Firmenadresse, Ansprechpartner-Daten und Teilnehmer pflegen.</p>\n    <p style=\"margin: 32px 0;\">\n      <a href=\"{{ $json.body.link_url }}\" style=\"background: #030386; color: #FFFFFF; padding: 12px 24px; text-decoration: none; border-radius: 8px; font-weight: 600; display: inline-block;\">Jetzt einloggen</a>\n    </p>\n    <p style=\"font-size: 14px; color: #64748B;\">Der Link ist <strong>30 Minuten</strong> gültig und funktioniert nur einmal.</p>\n    <p style=\"font-size: 14px; color: #64748B;\">Wenn du keinen Login angefordert hast, kannst du diese E-Mail einfach ignorieren.</p>\n    <p style=\"font-size: 12px; color: #94A3B8; word-break: break-all; margin-top: 32px;\">Funktioniert der Button nicht? Kopiere diese Adresse in deinen Browser:<br>{{ $json.body.link_url }}</p>\n  </div>\n  <div style=\"padding-top: 16px; border-top: 1px solid #E2E8F0; font-size: 12px; color: #94A3B8;\">\n    Next Skills · Copilot Partner Masterclass\n  </div>\n</div>",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b0f1b8a1-0003-4c01-9f1a-cccccccccccc",
      "name": "Mail-Inhalt vorbereiten",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        240
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "subject": "={{ $json.subject }}",
        "bodyContent": "={{ $json.html_body }}",
        "bodyContentType": "html",
        "toRecipients": "={{ $json.email }}",
        "additionalFields": {}
      },
      "id": "b0f1b8a1-0004-4c01-9f1a-dddddddddddd",
      "name": "Login-Mail senden (Outlook)",
